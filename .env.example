# The default local-only preview still binds to 127.0.0.1.
MCP_MODE=local
MCP_TOKEN_ISSUER=https://identity.example.invalid/
MCP_TOKEN_AUDIENCE=https://resource.example.invalid/mcp
MCP_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
MCP_ACCESS_REGISTRY=./access-registry.json
PORT=3000

# See docs/AUTHENTICATION.md for Entra ID registration and token validation.
# Never commit real tenant IDs, credentials, access tokens, or access-registry.json.
# MCP_MODE=remote
# MCP_PUBLIC_URL=https://mcp.your-domain.example/mcp
# MCP_BIND_HOST=0.0.0.0
# MCP_AUTHORIZATION_SERVER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# MCP_TOKEN_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# MCP_JWKS_URL=https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys
# MCP_TOKEN_AUDIENCE=<ENTRA_API_APPLICATION_ID_OR_IDENTIFIER_URI>
# MCP_REQUIRED_SCOPE=access_as_user
